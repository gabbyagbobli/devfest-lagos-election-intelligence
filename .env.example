# ============================================================================
# DevFest Lagos 2026 — Election Intelligence ADK Agent Configuration
# ============================================================================

# Option A: Google AI Studio / Gemini Developer API Key
GOOGLE_API_KEY=

# Option B: Google Cloud Vertex AI / Agent Platform
# Set GOOGLE_GENAI_USE_VERTEXAI=1 and provide your GCP Project ID
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_CLOUD_PROJECT=managed-agents-world-cup
GOOGLE_CLOUD_LOCATION=global

# Gemini Model used by Google ADK agents
ADK_MODEL=gemini-3.8-flash

# Optional: Set FORCE_OFFLINE_ENGINE=1 to force deterministic local corpus mode
FORCE_OFFLINE_ENGINE=0
